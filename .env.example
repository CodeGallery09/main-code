# Book-a-demo delivery (server-only — never prefix with NEXT_PUBLIC_).
# Until DEMO_REQUEST_WEBHOOK_URL is set, /api/demo-request returns 503 and the form says the request was not sent.
DEMO_REQUEST_WEBHOOK_URL=
# Optional: sent as "Authorization: Bearer <secret>" to the webhook.
DEMO_REQUEST_WEBHOOK_SECRET=

# Signs the demo-mode session cookie (lib/auth.ts), which is only used when DATABASE_URL is
# unset. With a database, sessions are random ids stored in Postgres and this is not used.
# Generate with: openssl rand -hex 32
AUTH_SESSION_SECRET=

# ---------------------------------------------------------------- database --
# Postgres connection string. Unset, the app falls back to the in-memory demo store
# (lib/data/memory.ts) and nothing persists — useful for the marketing pages alone.
#
# Use the POOLED endpoint, not the direct one: serverless invocations open far more
# connections than Postgres allows. On Neon the pooled host contains "-pooler".
#   postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# ----------------------------------------------------------------- sign-up --
# Sign-up is INVITE-ONLY. List the exact email addresses allowed to create an account, separated
# by commas, spaces or newlines. Matching is exact and case-insensitive: no domain wildcards.
# Unset or empty means NOBODY can sign up (closed by default). Requires DATABASE_URL.
#   SIGNUP_ALLOWED_EMAILS=ana@example.com, ben@example.com, chloe@example.com
SIGNUP_ALLOWED_EMAILS=

# ------------------------------------------------------------------- seeding --
# Local and demo use only. `npm run db:seed` replaces the "w_demo" workspace with invented sample
# data and (re)sets the owner's password to SEED_OWNER_PASSWORD. If you leave it unset the
# password falls back to a default that is committed in scripts/seed-db.ts, so NEVER run the seed
# against a database real people use without setting both of these to values of your own.
# Real users do not need the seed at all: they sign up (see SIGNUP_ALLOWED_EMAILS).
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
